{
	"info": {
		"_postman_id": "test-collection-1c-bridge",
		"name": "1C Bridge API Tests",
		"description": "Тесты для проверки новой интеграции CRM с 1С через bridge сервис",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "bridge_url",
			"value": "http://127.0.0.1:8013",
			"type": "string"
		},
		{
			"key": "bridge_secret",
			"value": "",
			"type": "string"
		}
	],
	"auth": {
		"type": "apikey",
		"apikey": [
			{
				"key": "X-Bridge-Secret",
				"value": "{{bridge_secret}}",
				"in": "header"
			}
		]
	},
	"item": [
		{
			"name": "Health Check",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{bridge_url}}/health",
					"host": ["{{bridge_url}}"],
					"path": ["health"]
				},
				"description": "Проверка доступности bridge сервиса"
			}
		},
		{
			"name": "Create Invoice",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"crm_invoice_id\": \"12345\",\n  \"crm_deal_id\": \"67890\",\n  \"customer_name\": \"Иванов Иван Иванович\",\n  \"customer_email\": \"ivanov@example.com\",\n  \"service_name\": \"Консультационная услуга\",\n  \"amount\": \"15000.00\",\n  \"comment\": \"Тестовый счет для проверки интеграции\"\n}"
				},
				"url": {
					"raw": "{{bridge_url}}/invoice/create",
					"host": ["{{bridge_url}}"],
					"path": ["invoice", "create"]
				},
				"description": "Создание счета в 1С"
			},
			"response": []
		},
		{
			"name": "Register Payment",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"crm_invoice_id\": \"12345\",\n  \"onec_document_id\": \"00000000-0000-0000-0000-000000000001\",\n  \"yookassa_payment_id\": \"yp_1234567890\",\n  \"amount\": \"15000.00\",\n  \"payment_date\": \"2026-04-22T23:30:00\",\n  \"payment_method\": \"yookassa\",\n  \"comment\": \"Оплата через YooKassa\"\n}"
				},
				"url": {
					"raw": "{{bridge_url}}/payment/register",
					"host": ["{{bridge_url}}"],
					"path": ["payment", "register"]
				},
				"description": "Регистрация оплаты в 1С"
			},
			"response": []
		},
		{
			"name": "Legacy Invoke Test",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"method\": \"GET\",\n  \"path\": \"$metadata\",\n  \"params\": {},\n  \"timeout\": 20,\n  \"restart_before_request\": false\n}"
				},
				"url": {
					"raw": "{{bridge_url}}/invoke",
					"host": ["{{bridge_url}}"],
					"path": ["invoke"]
				},
				"description": "Тест legacy совместимости"
			},
			"response": []
		}
	]
}
