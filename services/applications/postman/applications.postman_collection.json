{
  "info": {
    "_postman_id": "c5d2ef4e-1b53-4c26-a9c8-0c6f9b8d4d30",
    "name": "CRM Applications Service",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8009"
    },
    {
      "key": "applicationId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Fetch from mail (load all emails)",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{baseUrl}}/api/applications/fetch_from_mail/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "applications",
            "fetch_from_mail",
            ""
          ]
        }
      }
    },
    {
      "name": "List applications (all)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/applications/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "applications",
            ""
          ]
        }
      }
    },
    {
      "name": "Filter by status (is_processed=false)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/applications/?is_processed=false",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "applications",
            ""
          ],
          "query": [
            {
              "key": "is_processed",
              "value": "false"
            }
          ]
        }
      }
    },
    {
      "name": "Search by text (\"заявка\")",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/applications/?search=%D0%B7%D0%B0%D1%8F%D0%B2%D0%BA%D0%B0",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "applications",
            ""
          ],
          "query": [
            {
              "key": "search",
              "value": "заявка"
            }
          ]
        }
      }
    },
    {
      "name": "Retrieve application by id",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/applications/{{applicationId}}/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "applications",
            "{{applicationId}}",
            ""
          ]
        }
      }
    }
  ]
}

