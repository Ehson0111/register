                  "pm.test('Status is 403 for client role', function () {",
                  "  pm.response.to.have.status(403);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{clientToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/chat/rooms/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "chat",
                "rooms",
                ""
              ]
            }
          }
        }
      ]
    }
