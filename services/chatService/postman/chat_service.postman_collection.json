{
  "info": {
    "name": "Chat Service (Django) — Managers/Admins Chat API",
    "_postman_id": "9e2d7f76-9f4a-4f29-9fbf-32d7eecf43b3",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Chat Service Health (direct)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "pm.test('Service is chat-service', function () {",
                  "  pm.expect(body.service).to.eql('chat-service');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{chatServiceUrl}}/health/",
              "host": [
                "{{chatServiceUrl}}"
              ],
              "path": [
                "health",
                ""
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login manager (set token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('token', body.access || '');",
                  "pm.collectionVariables.set('manager_user_id', String((body.user && body.user.id) || ''));",
                  "",
                  "pm.test('Access token received', function () {",
                  "  pm.expect(body.access).to.be.a('string').and.not.empty;",
                  "});",
                  "",
                  "pm.test('Manager/Admin role logged in', function () {",
                  "  pm.expect(['manager', 'admin']).to.include(body.user.role);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{managerEmail}}\",\n  \"password\": \"{{managerPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login",
                ""
              ]
            }
          }
        },
        {
          "name": "Login client (set clientToken for negative tests)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('clientToken', body.access || '');",
                  "",
                  "pm.test('Client token received', function () {",
                  "  pm.expect(body.access).to.be.a('string').and.not.empty;",
                  "});",
                  "",
                  "pm.test('Client role logged in', function () {",
                  "  pm.expect(body.user.role).to.eql('client');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{clientEmail}}\",\n  \"password\": \"{{clientPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login",
                ""
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Chat Rooms",
      "item": [
        {
          "name": "List my rooms (manager/admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "pm.test('Response is array', function () {",
                  "  pm.expect(Array.isArray(body)).to.eql(true);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/chat/rooms/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "chat",
                "rooms",
                ""
              ]
            }
          }
        },
        {
          "name": "Create room (manager/admin only)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const fallbackUserId = pm.collectionVariables.get('manager_user_id') || '1';",
                  "pm.collectionVariables.set('manager_user_id', fallbackUserId);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('room_id', String(body.id || ''));",
                  "",
                  "pm.test('Room id saved', function () {",
                  "  pm.expect(pm.collectionVariables.get('room_id')).to.match(/^\\d+$/);",
                  "});",
                  "",
                  "pm.test('Participants include manager and second participant', function () {",
                  "  pm.expect(body.participants).to.be.an('array');",
                  "  pm.expect(body.participants.length).to.be.greaterThan(1);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Managers/Admin Chat\",\n  \"participants\": [\n    {\n      \"user_id\": {{manager_user_id}},\n      \"role\": \"manager\",\n      \"email\": \"{{managerEmail}}\",\n      \"first_name\": \"Manager\",\n      \"last_name\": \"One\"\n    },\n    {\n      \"user_id\": {{other_user_id}},\n      \"role\": \"{{other_user_role}}\",\n      \"email\": \"{{other_user_email}}\",\n      \"first_name\": \"Admin\",\n      \"last_name\": \"Two\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/chat/rooms/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "chat",
                "rooms",
                ""
              ]
            }
          }
        },
        {
          "name": "Get room by id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "pm.test('Returned expected room', function () {",
                  "  pm.expect(String(body.id)).to.eql(pm.collectionVariables.get('room_id'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/chat/rooms/{{room_id}}/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "chat",
                "rooms",
                "{{room_id}}",
                ""
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Messages",
      "item": [
        {
          "name": "Create message in room",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const stamp = new Date().toISOString();",
                  "pm.collectionVariables.set('message_text', `Postman test message ${stamp}`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('message_id', String(body.id || ''));",
                  "",
                  "pm.test('Message created in selected room', function () {",
                  "  pm.expect(String(body.room)).to.eql(pm.collectionVariables.get('room_id'));",
                  "  pm.expect(body.text).to.eql(pm.collectionVariables.get('message_text'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"{{message_text}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/chat/rooms/{{room_id}}/messages/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "chat",
                "rooms",
                "{{room_id}}",
                "messages",
                ""
              ]
            }
          }
        },
        {
          "name": "List room messages",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "pm.test('Response is array', function () {",
                  "  pm.expect(Array.isArray(body)).to.eql(true);",
                  "});",
                  "",
                  "const messageId = pm.collectionVariables.get('message_id');",
                  "if (messageId) {",
                  "  const found = body.some(m => String(m.id) === String(messageId));",
                  "  pm.test('Created message is present in list', function () {",
                  "    pm.expect(found).to.eql(true);",
                  "  });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/chat/rooms/{{room_id}}/messages/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "chat",
                "rooms",
                "{{room_id}}",
                "messages",
                ""
              ]
            }
          }
        }
      ]
    },
